Film film : Color {
  resolution { 512 }
  exposure { 0 }
}

Camera camera : Pinhole {
  position { -0.01, 0.995, 5.0 }
  fov { 27.8 }
  spp { 1024 }
  film { @film }
  file { "../renders/cbox_pm_diff_spp_1024_sep.exr" }
  filter : Gaussian {
    radius { 1 }
  }
}

import "../meshes/cbox.luisa"

Integrator pm_diff : megappm_diff {
  sampler : Independent {}
  depth { 6 }
}

Integrator normal : Normal {}

render {
  cameras { @camera }
  shapes { @cbox }
  integrator { @pm_diff }
  spectrum : sRGB {}
  // environment : Directional {
  //   direction { 1, 1.1, 1.3 }
  //   emission : Constant {
  //     v { 17, 12, 4 }
  //     semantic { "illuminant" }
  //   }
  //   scale { 0.015 }
  //   angle { 0.54 }
  // }
}
